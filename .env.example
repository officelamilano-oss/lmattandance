MONGODB_URI=mongodb+srv://<USERNAME>:<URL_ENCODED_PASSWORD>@<CLUSTER_HOST>/<DATABASE_NAME>?retryWrites=true&w=majority&appName=la-milano-attendance
MONGODB_DB=your_database_name
AUTH_SECRET=<GENERATE_WITH_OPENSSL_RAND_BASE64_32>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<SET_A_UNIQUE_PASSWORD_AT_LEAST_10_CHARACTERS>
BOOTSTRAP_ADMIN_EMAIL=<ADMIN_EMAIL>
BOOTSTRAP_ADMIN_NAME=<ADMIN_DISPLAY_NAME>
BUSINESS_TIMEZONE=Asia/Kolkata
STORAGE_PROVIDER=imagekit

# ImageKit (server-only)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Cloudinary (server-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Private employee-document storage
STORAGE_SIGNED_URL_EXPIRY=600
MAX_FILE_SIZE_MB=10
